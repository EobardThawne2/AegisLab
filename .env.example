# Copy this file to .env. Never record or commit .env.
# Copy the pooler URI from Supabase > Connect, then percent-encode the password.
# Example shape only (do not use these placeholders as a real connection):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Descriptive metadata: session or transaction. Copy the matching URI/port.
DATABASE_POOLER_MODE=session
# The backend enforces encrypted connections. verify-full requires a trusted CA.
DATABASE_SSLMODE=require
# Optional path to a trusted Supabase CA certificate for verify-full.
DATABASE_SSLROOTCERT=

# Local default: additive migrations at trusted application startup.
AEGISLAB_ENV=development
AEGISLAB_AUTO_MIGRATE=true
# Production: exact https origin, no trailing slash; Secure cookies enabled.
AEGISLAB_PUBLIC_ORIGIN=
# Production only: base64 32-byte Ed25519 private key, never committed.
# Local development uses ignored local-data/signing-key.pem.
AEGISLAB_SIGNING_KEY=
